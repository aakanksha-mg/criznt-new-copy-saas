{
  "name": "crizant-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Crizant One — commission & incentive operating system. Marketing site.",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:client && npm run build:server && npm run prerender",
    "build:client": "vite build --outDir dist/client --ssrManifest",
    "build:server": "vite build --outDir dist/server --ssr src/entry-server.tsx",
    "prerender": "node scripts/prerender.mjs",
    "preview": "vite preview --outDir dist/client",
    "serve": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
